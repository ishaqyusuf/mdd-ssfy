{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    ".env",
    ".env.local",
    ".env.dev",
    ".env.preview",
    ".env.production"
  ],
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "ALLOWED_API_ORIGINS",
        "DATABASE_URL",
        "REDIS_URL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "NEXT_PUBLIC_SALES_CATALOG_CACHE",
        "GND_SALES_CATALOG_CACHE",
        "GND_SALES_CATALOG_TIMING",
        "DEFAULT_COMPANY_PASSWORD",
        "ENC_SECRET_KEY",
        "SQUARE_SANDBOX_ACCESS_TOKEN",
        "TRIGGER_PROJECT_ID",
        "SQUARE_SANDBOX_LOCATION_ID",
        "SQUARE_SANDBOX_APP_ID",
        "SQUARE_LOCATION_ID",
        "SQUARE_APP_ID",
        "SQUARE_ACCESS_TOKEN",
        "NEXTAUTH_SECRET",
        "NEXT_PUBLIC_API_URL",
        "EMAIL_FROM_ADDRESS",
        "RESEND_API_KEY",
        "BLESS_TOKEN",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_ACCOUNT_TOKEN",
        "TWILIO_PHONE",
        "CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "CLOUDINARY_UPLOAD_URL",
        "PLACE_API",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_PROJECT_MOBILE",
        "SENTRY_PROJECT_BACKEND",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_RELEASE",
        "GIT_COMMIT_SHA",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA",
        "NEXT_PUBLIC_VERCEL_ENV",
        "NEXT_PUBLIC_SENTRY_DSN",
        "EXPO_PUBLIC_SENTRY_DSN",
        "EXPO_PUBLIC_SENTRY_ENABLED",
        "EXPO_PUBLIC_SENTRY_DEBUG",
        "EXPO_PUBLIC_SENTRY_SMOKE_TEST",
        "TRIGGER_SECRET_KEY",
        "NEXT_PUBLIC_VERCEL_BLOB_URL",
        "NEXT_BACK_DOOR_TOK",
        "BLOB_READ_WRITE_TOKEN",
        "CRON_SECRET",
        "LOGLY_COLLECTOR_URL",
        "LOGLY_PROJECT_KEY",
        "LOGLY_MOBILE_PROJECT_KEY",
        "LOGLY_MOBILE_PROJECT",
        "LOGLY_SERVER_KEY",
        "LOGLY_SERVER_PROJECT",
        "GND_LOGLY_ORIGIN",
        "NEXT_PUBLIC_LOGLY_ENABLED",
        "NEXT_PUBLIC_LOGLY_PROJECT",
        "EXPO_PUBLIC_LOGLY_ENABLED",
        "EXPO_PUBLIC_LOGLY_ENDPOINT",
        "EXPO_PUBLIC_LOGLY_PROJECT",
        "GND_SALES_ORDERS_READ_MODEL_MODE",
        "GND_SALES_ORDERS_READ_MODEL_COHORT_PERCENTAGE"
      ],
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "next-env.d.ts",
        ".expo/**",
        "dist/**",
        "build/**",
        "lib/**"
      ]
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "generate": {
      "cache": false,
      "interactive": true
    },
    "migrate": {
      "cache": false,
      "interactive": true
    },
    "pull": {
      "cache": false,
      "interactive": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "env": ["SQUARE_FORCE_PRODUCTION", "SQUARE_SANDBOX_ACCESS_TOKEN"],
      "dependsOn": ["^dev", "^generate"],
      "persistent": true,
      "cache": false
    },
    "dev:prod": {
      "dependsOn": ["^dev:prod"],
      "persistent": true,
      "cache": false
    },
    "format": {},
    "lint": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": []
    },
    "clean": {
      "cache": false,
      "dependsOn": ["^clean"]
    }
  }
}
