model CommissionPayment {
    id            Int              @unique @default(autoincrement())
    amount        Float
    userId        Int
    paidBy        Int
    checkNo       String?
    paymentMethod String?
    meta          Json?            @db.Json
    deletedAt     DateTime?        @db.Timestamp(0)
    createdAt     DateTime?        @default(now()) @db.Timestamp(0)
    updatedAt     DateTime?        @updatedAt
    commissions   SalesCommision[]
    user          Users?           @relation(name: "worker", fields: [userId], references: [id])
    payer         Users?           @relation(name: "payer", fields: [paidBy], references: [id])
    Users         Users?           @relation(fields: [usersId], references: [id])
    usersId       Int?

    @@index([userId])
    @@index([paidBy])
    @@index([usersId])
}

model SalesOrders {
    id                Int                              @unique @default(autoincrement())
    title             String?                          @db.VarChar(255)
    customerId        Int?
    billingAddressId  Int?
    shippingAddressId Int?
    salesRepId        Int?
    pickupId          Int?
    prodId            Int?
    dealerAuthId      Int?
    isDyke            Boolean?                         @default(false)
    summary           String?                          @db.Text
    instruction       String?                          @db.Text
    meta              Json?                            @db.Json
    status            String?                          @db.VarChar(255)
    inventoryStatus   String?                          @db.VarChar(255)
    deletedAt         DateTime?                        @db.Timestamp(0)
    createdAt         DateTime?                        @default(now()) @db.Timestamp(0)
    updatedAt         DateTime?                        @updatedAt
    orderId           String                           @db.VarChar(255)
    slug              String                           @db.VarChar(255)
    type              String?                          @db.VarChar(255)
    goodUntil         DateTime?
    priority          SalesPriority?                   @default(NORMAL)
    paymentTerm       String?
    prodQty           Float?
    builtQty          Float?
    subTotal          Float?
    profitMargin      Float?
    tax               Float?
    taxPercentage     Float?
    grandTotal        Float?
    amountDue         Float?
    invoiceStatus     String?                          @db.VarChar(255)
    prodStatus        String?                          @db.VarChar(255)
    prodDueDate       DateTime?                        @db.Timestamp(0)
    deliveryDueDate   DateTime?                        @db.Timestamp(0)
    paymentDueDate    DateTime?                        @db.Timestamp(0)
    deliveredAt       DateTime?
    deliveryOption    String?
    customerProfileId Int?
    dealerSalesProfileId Int?
    salesChannel      String?                          @db.VarChar(64)
    specialOrderDeclaration SalesSpecialOrderDeclaration?
    specialOrderStatus SalesSpecialOrderStatus?
    specialOrderRevision String?                       @db.VarChar(64)
    currentSpecialOrderRequestId String?               @db.VarChar(191)
    currentSpecialOrderApprovalId String?              @unique @db.VarChar(191)
    taxes             SalesTaxes[]
    checkouts         SalesCheckout[]
    refunds           Refunds[]                        @relation(name: "salesRefunds")
    refund            Refunds?                         @relation(name: "refund")
    assignments       OrderItemProductionAssignments[]
    billingAddress    AddressBooks?                    @relation(name: "billingAddress", fields: [billingAddressId], references: [id])
    commisions        SalesCommision[]
    customer          Customers?                       @relation(fields: [customerId], references: [id])
    dealerAuth        DealerAuth?                      @relation(fields: [dealerAuthId], references: [id])
    dealerSale        DealerSales?
    deliveries        OrderDelivery[]
    doors             DykeSalesDoors[]
    formSteps         DykeStepForm[]
    housePackageTools HousePackageTools[]
    items             SalesOrderItems[]
    itemControls      SalesItemControl[]
    itemDeliveries    OrderItemDelivery[]
    payments          SalesPayments[]                  @relation(name: "salesPayment")
    pickup            SalesPickup?                     @relation(fields: [pickupId], references: [id])
    pricings          ComponentPrice[]
    producer          Users?                           @relation(name: "producer", fields: [prodId], references: [id])
    productions       OrderProductionSubmissions[]
    requests          DealerSalesRequest[]
    salesProfile      CustomerTypes?                   @relation(fields: [customerProfileId], references: [id])
    dealerSalesProfile CustomerTypes?                  @relation(name: "dealerSalesProfile", fields: [dealerSalesProfileId], references: [id])
    salesRep          Users?                           @relation(name: "salesRep", fields: [salesRepId], references: [id])
    shippingAddress   AddressBooks?                    @relation(name: "shippingAddress", fields: [shippingAddressId], references: [id])
    stat              SalesStat[]
    extraCosts        SalesExtraCosts[]
    squarePayOrders   SquarePaymentOrders[]
    payrolls          Payroll[]
    history           SalesHistory[]
    lineItems         LineItem[]
    inventoryProjection SalesInventoryProjectionState?
    listProjection      SalesOrderListProjection?
    productionGate    OrderProductionGate?
    productionReadinessOverride SalesProductionReadinessOverride?
    productionSubmissionMaterialReviews SalesProductionSubmissionMaterialReview[]
    packingReports    SalesPackingReport[]
    adjustments       SalesOrderAdjustment[]
    workflowCancellations SalesWorkflowCancellation[]
    completionRecords SalesCompletionRecord[]
    specialOrderRequests SpecialOrderApprovalRequest[]
    specialOrderEvidence SpecialOrderApprovalEvidence[] @relation(name: "SpecialOrderEvidence")
    handoffActionEpochs SalesHandoffActionEpoch[]
    salesTaxLedgerEntries SalesTaxLedgerEntry[]

    org   Organization? @relation(fields: [orgId], references: [id])
    orgId Int?

    @@unique([orderId, type])
    @@index([orgId])
    @@index([createdAt, deletedAt, orderId, grandTotal, prodId, type, prodDueDate])
    @@index([customerProfileId])
    @@index([dealerAuthId])
    @@index([dealerSalesProfileId])
    @@index([customerId])
    @@index([salesChannel, createdAt])
    @@index([specialOrderDeclaration, specialOrderStatus])
    @@index([deletedAt, status, prodStatus, id], name: "idx_sales_fulfillment_queue")
    @@index([deletedAt, deliveryOption, id], name: "idx_sales_delivery_queue")
    @@index([shippingAddressId])
    @@index([billingAddressId])
    @@index([prodId])
    @@index([salesRepId])
    @@index([pickupId])
}

enum SalesSpecialOrderDeclaration {
    NO
    YES
}

enum SalesSpecialOrderStatus {
    NOT_REQUIRED
    SIGNATURE_PENDING
    CUSTOMER_APPROVED
    REAPPROVAL_REQUIRED
    CUSTOMER_DECLINED
}

enum SpecialOrderPolicyStatus {
    DRAFT
    PUBLISHED
    RETIRED
}

enum SpecialOrderApprovalRequestStatus {
    ACTIVE
    CONSUMED
    REVOKED
    EXPIRED
}

enum SpecialOrderApprovalOutcome {
    APPROVED
    DECLINED
}

model SpecialOrderPolicyVersion {
    id                 String                         @id @default(cuid())
    version            Int?                           @unique
    status             SpecialOrderPolicyStatus       @default(DRAFT)
    title              String                         @db.VarChar(255)
    acknowledgmentText String                         @db.Text
    policyText         String                         @db.Text
    createdByUserId    Int?
    publishedByUserId  Int?
    publishedAt        DateTime?                      @db.Timestamp(0)
    retiredAt          DateTime?                      @db.Timestamp(0)
    createdAt          DateTime                       @default(now()) @db.Timestamp(0)
    updatedAt          DateTime                       @updatedAt
    requests           SpecialOrderApprovalRequest[]
    evidence           SpecialOrderApprovalEvidence[]

    @@index([status, version])
    @@index([publishedAt])
}

model SpecialOrderApprovalRequest {
    id                 String                            @id @default(cuid())
    salesOrderId       Int
    policyVersionId    String
    orderRevision      String                            @db.VarChar(64)
    status             SpecialOrderApprovalRequestStatus @default(ACTIVE)
    tokenHash          String                            @unique @db.VarChar(191)
    idempotencyKey     String                            @unique @db.VarChar(191)
    sentToEmail        String                            @db.VarChar(255)
    orderSnapshot      Json?                             @db.Json
    customerSnapshot   Json?                             @db.Json
    salespersonSnapshot Json?                            @db.Json
    sentAt             DateTime                          @default(now()) @db.Timestamp(0)
    deliveredAt        DateTime?                         @db.Timestamp(0)
    deliveryStatus     String                            @default("PENDING") @db.VarChar(32)
    lastDeliveryError  String?                           @db.Text
    expiresAt          DateTime                          @db.Timestamp(0)
    consumedAt         DateTime?                         @db.Timestamp(0)
    revokedAt          DateTime?                         @db.Timestamp(0)
    revokedReason      String?                           @db.VarChar(255)
    issuedByUserId     Int?
    createdAt          DateTime                          @default(now()) @db.Timestamp(0)
    updatedAt          DateTime                          @updatedAt
    order              SalesOrders                      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
    policyVersion      SpecialOrderPolicyVersion         @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
    evidence           SpecialOrderApprovalEvidence?

    @@index([salesOrderId, status, createdAt])
    @@index([expiresAt, status])
    @@index([policyVersionId])
}

model SpecialOrderApprovalEvidence {
    id                  String                       @id @default(cuid())
    salesOrderId        Int
    requestId           String                       @unique
    policyVersionId     String
    orderRevision       String                       @db.VarChar(64)
    outcome             SpecialOrderApprovalOutcome
    customerName        String                       @db.VarChar(255)
    customerEmail       String                       @db.VarChar(255)
    declineReason       String?                      @db.Text
    signatureDocumentId String?                      @db.VarChar(191)
    policyTitle         String                       @db.VarChar(255)
    acknowledgmentText  String                       @db.Text
    policyText          String                       @db.Text
    orderSnapshot       Json                         @db.Json
    customerSnapshot    Json                         @db.Json
    salespersonSnapshot Json                         @db.Json
    ipAddress           String?                      @db.VarChar(64)
    userAgent           String?                      @db.Text
    acknowledgedAt      DateTime                     @default(now()) @db.Timestamp(0)
    supersededAt        DateTime?                    @db.Timestamp(0)
    supersededReason    String?                      @db.Text
    supersededByUserId  Int?
    createdAt           DateTime                     @default(now()) @db.Timestamp(0)
    order               SalesOrders                  @relation(name: "SpecialOrderEvidence", fields: [salesOrderId], references: [id], onDelete: Restrict)
    request             SpecialOrderApprovalRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict)
    policyVersion       SpecialOrderPolicyVersion     @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

    @@index([salesOrderId, acknowledgedAt])
    @@index([policyVersionId])
    @@index([signatureDocumentId])
}

model SpecialOrderNotificationDelivery {
    id             String   @id @default(cuid())
    eventKey       String   @unique @db.VarChar(191)
    salesOrderId   Int
    eventType      String   @db.VarChar(64)
    customerStatus String   @default("PENDING") @db.VarChar(32)
    staffStatus    String   @default("PENDING") @db.VarChar(32)
    inAppStatus    String   @default("PENDING") @db.VarChar(32)
    attempts       Int      @default(0)
    payload        Json     @db.Json
    lastError      String?  @db.Text
    lastAttemptAt  DateTime? @db.Timestamp(0)
    completedAt    DateTime? @db.Timestamp(0)
    createdAt      DateTime @default(now()) @db.Timestamp(0)
    updatedAt      DateTime @updatedAt

    @@index([salesOrderId, createdAt])
    @@index([customerStatus, staffStatus, inAppStatus, updatedAt])
}

model SpecialOrderOperationEvent {
    id              Int      @id @default(autoincrement())
    eventKey        String   @unique @db.VarChar(191)
    salesOrderId    Int
    orderRevision   String?  @db.VarChar(64)
    operation       String   @db.VarChar(32)
    enforcementMode String   @db.VarChar(64)
    result          String   @db.VarChar(32)
    source          String?  @db.VarChar(191)
    actorUserId     Int?
    meta            Json?    @db.Json
    occurredAt      DateTime @default(now()) @db.Timestamp(0)

    @@index([salesOrderId, occurredAt])
    @@index([result, operation, occurredAt])
    @@index([enforcementMode, occurredAt])
}

model SalesWorkflowCancellation {
    id                Int         @id @default(autoincrement())
    requestId         String      @unique @db.VarChar(64)
    salesOrderId      Int
    action            String      @db.VarChar(32)
    reason            String      @db.Text
    revision          String      @db.VarChar(64)
    beforeState       Json        @db.Json
    result            Json        @db.Json
    performedByUserId Int
    createdAt         DateTime    @default(now()) @db.Timestamp(0)
    order             SalesOrders @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
    performedBy       Users       @relation(name: "salesWorkflowCancellationsPerformed", fields: [performedByUserId], references: [id], onDelete: Restrict)

    @@index([salesOrderId, createdAt])
    @@index([performedByUserId, createdAt])
    @@index([action, createdAt])
}

model SalesInventoryProjectionState {
    id           Int          @id @default(autoincrement())
    salesOrderId Int          @unique
    status       String       @default("syncing") @db.VarChar(32)
    version      Int          @default(1)
    needCount    Int          @default(0)
    requiredQty  Float        @default(0)
    source       String?      @db.VarChar(32)
    lastError    String?      @db.Text
    startedAt    DateTime?    @db.Timestamp(0)
    completedAt  DateTime?    @db.Timestamp(0)
    createdAt    DateTime?    @default(now()) @db.Timestamp(0)
    updatedAt    DateTime?    @updatedAt
    salesOrder   SalesOrders  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

    @@index([status, updatedAt])
}

model SalesOrderListProjection {
    id              Int         @id @default(autoincrement())
    salesOrderId    Int         @unique
    orgId           Int?
    salesRepId      Int?
    customerId      Int?
    orderId         String      @db.VarChar(255)
    slug            String      @db.VarChar(255)
    type            String?     @db.VarChar(255)
    status          String?     @db.VarChar(255)
    prodStatus      String?     @db.VarChar(255)
    amountDue       Float?
    invoiceTotal    Float?
    salesCreatedAt  DateTime?   @db.Timestamp(0)
    salesDeletedAt  DateTime?   @db.Timestamp(0)
    sourceUpdatedAt DateTime
    version         Int         @default(1)
    state           String      @default("ready") @db.VarChar(32)
    payload         Json        @db.Json
    lastError       String?     @db.Text
    projectedAt     DateTime    @default(now()) @db.Timestamp(0)
    createdAt       DateTime    @default(now()) @db.Timestamp(0)
    updatedAt       DateTime    @updatedAt
    salesOrder      SalesOrders @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

    @@index([orgId, salesDeletedAt, salesCreatedAt, salesOrderId], name: "idx_sales_order_list_scope")
    @@index([salesRepId, salesDeletedAt, salesCreatedAt, salesOrderId], name: "idx_sales_order_list_rep")
    @@index([state, version, projectedAt], name: "idx_sales_order_list_health")
}

enum DealerSellerOfRecord {
    DEALER
    GND
}

model DealerSales {
    id                        Int                  @unique @default(autoincrement())
    salesOrderId              Int                  @unique
    dealerAuthId              Int
    customerId                Int
    dealerCustomerProfileId   Int
    sellerOfRecord            DealerSellerOfRecord @default(DEALER)
    selectedTaxModelId        String?              @db.VarChar(255)
    selectedTaxModelName      String?              @db.VarChar(255)
    selectedTaxModelSnapshot  Json?                @db.Json
    internalSubtotal          Float                 @default(0)
    internalTaxableSubtotal   Float                 @default(0)
    internalTax               Float                 @default(0)
    dealerSubtotal            Float                 @default(0)
    dealerTaxableSubtotal     Float                 @default(0)
    dealerCustomerTax         Float                 @default(0)
    dealerMarkupAmount        Float                 @default(0)
    dealerSalesPercentage     Float
    resaleCertificateOnFile   Boolean               @default(false)
    grandTotal                Float
    dueAmount                 Float
    createdAt                 DateTime?             @default(now()) @db.Timestamp(0)
    updatedAt                 DateTime?             @updatedAt
    salesOrder                SalesOrders           @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
    dealerAuth                DealerAuth            @relation(fields: [dealerAuthId], references: [id])
    customer                  Customers             @relation(fields: [customerId], references: [id])
    dealerCustomerProfile     CustomerTypes         @relation(name: "dealerSaleCustomerProfile", fields: [dealerCustomerProfileId], references: [id])

    @@index([dealerAuthId])
    @@index([customerId])
    @@index([dealerCustomerProfileId])
}

model OrderProductionGate {
    id             Int                         @unique @default(autoincrement())
    salesOrderId   Int                         @unique
    status         OrderProductionGateStatus   @default(missing)
    ruleType       OrderProductionGateRuleType?
    leadTimeValue  Int?
    leadTimeUnit   OrderProductionGateTimeUnit?
    definedAt      DateTime?                   @db.Timestamp(0)
    definedByUserId Int?
    triggeredAt    DateTime?                   @db.Timestamp(0)
    createdAt      DateTime?                   @default(now()) @db.Timestamp(0)
    updatedAt      DateTime?                   @updatedAt
    order          SalesOrders                 @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
    definedBy      Users?                      @relation(fields: [definedByUserId], references: [id])

    @@index([definedByUserId])
    @@index([status])
}

model SalesProductionReadinessOverride {
    id                Int       @unique @default(autoincrement())
    salesOrderId      Int       @unique
    status            String    @default("ACTIVE") @db.VarChar(32)
    revision          String    @db.VarChar(64)
    snapshot          Json      @db.Json
    confirmedByUserId Int
    confirmedAt       DateTime  @default(now()) @db.Timestamp(0)
    revokedByUserId   Int?
    revokedAt         DateTime? @db.Timestamp(0)
    createdAt         DateTime? @default(now()) @db.Timestamp(0)
    updatedAt         DateTime? @updatedAt
    order             SalesOrders @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
    confirmedBy       Users     @relation(name: "confirmedProductionReadinessOverrides", fields: [confirmedByUserId], references: [id])
    revokedBy         Users?    @relation(name: "revokedProductionReadinessOverrides", fields: [revokedByUserId], references: [id])

    @@index([status])
    @@index([confirmedByUserId])
    @@index([revokedByUserId])
}

enum ProductionSubmissionMaterialReviewStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELLED
}

enum ProductionSubmissionMaterialReviewReason {
    AWAITING_INBOUND
    ALLOCATION_REVIEW
    BLOCKED
    NOT_CONFIGURED
    PROJECTION_UNAVAILABLE
}

model SalesProductionSubmissionMaterialReview {
    id                   Int                                      @id @default(autoincrement())
    salesOrderId         Int
    submittedById        Int
    reviewedById         Int?
    status               ProductionSubmissionMaterialReviewStatus @default(PENDING)
    classificationReason ProductionSubmissionMaterialReviewReason?
    idempotencyKey       String                                   @unique @db.VarChar(128)
    assignmentScope      Json                                     @db.Json
    materialSnapshot     Json                                     @db.Json
    materialRevision     String?                                  @db.VarChar(64)
    resolution           Json?                                    @db.Json
    decisionNote         String?                                  @db.Text
    submittedAt          DateTime                                 @default(now()) @db.Timestamp(0)
    reviewedAt           DateTime?                                @db.Timestamp(0)
    cancelledAt          DateTime?                                @db.Timestamp(0)
    createdAt            DateTime                                 @default(now()) @db.Timestamp(0)
    updatedAt            DateTime                                 @updatedAt
    order                SalesOrders                              @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
    submittedBy          Users                                    @relation(name: "productionSubmissionMaterialReviewsSubmitted", fields: [submittedById], references: [id])
    reviewedBy           Users?                                   @relation(name: "productionSubmissionMaterialReviewsReviewed", fields: [reviewedById], references: [id])
    submissions          OrderProductionSubmissions[]

    @@index([status, submittedAt])
    @@index([salesOrderId, status])
    @@index([submittedById, status])
    @@index([reviewedById])
}

enum SalesPackingReportStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELLED
}

enum SalesPackingReportReason {
    UPSTREAM_PRODUCTION_REVIEW
    STALE_UPSTREAM_EVIDENCE
    AWAITING_PRODUCTION_SUBMISSION
}

model SalesPackingReport {
    id                          Int                      @id @default(autoincrement())
    salesOrderId                Int
    orderDeliveryId             Int
    salesOrderItemId            Int
    orderProductionSubmissionId Int?
    dispatchAllocationItemId    Int
    salesItemControlUid          String?
    submittedById               Int
    reviewedById                Int?
    status                      SalesPackingReportStatus @default(PENDING)
    reason                      SalesPackingReportReason
    idempotencyKey              String                   @unique @db.VarChar(128)
    openKey                     String?                  @unique @db.VarChar(191)
    qty                         Int
    lhQty                       Int                      @default(0)
    rhQty                       Int                      @default(0)
    manifestRevision            String                   @db.VarChar(64)
    dispatchAllocationKey       String                   @db.VarChar(64)
    evidenceSnapshot            Json                     @db.Json
    note                        String?                  @db.Text
    decisionNote                String?                  @db.Text
    submittedAt                 DateTime                 @default(now()) @db.Timestamp(0)
    reviewedAt                  DateTime?                @db.Timestamp(0)
    rejectedAt                  DateTime?                @db.Timestamp(0)
    cancelledAt                 DateTime?                @db.Timestamp(0)
    createdAt                   DateTime                 @default(now()) @db.Timestamp(0)
    updatedAt                   DateTime                 @updatedAt
    order                       SalesOrders              @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
    delivery                    OrderDelivery            @relation(fields: [orderDeliveryId], references: [id], onDelete: Restrict)
    item                        SalesOrderItems           @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
    productionSubmission        OrderProductionSubmissions? @relation(fields: [orderProductionSubmissionId], references: [id], onDelete: Restrict)
    dispatchAllocationItem      OrderItemDelivery        @relation(fields: [dispatchAllocationItemId], references: [id], onDelete: Restrict)
    itemControl                 SalesItemControl?         @relation(fields: [salesItemControlUid], references: [uid], onDelete: Restrict)
    submittedBy                 Users                    @relation(name: "packingReportsSubmitted", fields: [submittedById], references: [id], onDelete: Restrict)
    reviewedBy                  Users?                   @relation(name: "packingReportsReviewed", fields: [reviewedById], references: [id], onDelete: Restrict)

    @@index([status, submittedAt])
    @@index([orderDeliveryId, status])
    @@index([orderDeliveryId, dispatchAllocationKey])
    @@index([salesOrderId, status])
    @@index([salesOrderItemId, status])
    @@index([orderProductionSubmissionId, status])
    @@index([salesItemControlUid, status])
    @@index([dispatchAllocationItemId])
    @@index([submittedById, status])
    @@index([reviewedById])
}

model SalesHistory {
    id         String       @unique @default(uuid())
    data       Json?        @db.Json
    name       String?
    authorName String?
    salesId    Int
    sale       SalesOrders? @relation(fields: [salesId], references: [id])
    createdAt  DateTime?    @default(now()) @db.Timestamp(0)
    updatedAt  DateTime?    @updatedAt
    deletedAt  DateTime?    @db.Timestamp(0)

    @@index([salesId])
}

enum SalesCompletionMilestone {
    PRODUCTION_COMPLETED
    FULFILLMENT_COMPLETED
}

enum SalesCompletionMethod {
    STATUS_ONLY
    FULL_WORKFLOW
}

enum SalesCompletionRecordState {
    ACTIVE
    CANCELLED
}

model SalesCompletionRecord {
    id                    String                     @id @default(cuid())
    requestId             String                     @unique @db.VarChar(64)
    cancellationRequestId String?                    @unique @db.VarChar(64)
    salesOrderId          Int
    milestone             SalesCompletionMilestone
    completionMethod      SalesCompletionMethod
    state                 SalesCompletionRecordState @default(ACTIVE)
    activeKey             String?                    @unique @db.VarChar(191)
    effectiveAt           DateTime?                  @db.Timestamp(0)
    recordedAt            DateTime                   @default(now()) @db.Timestamp(0)
    recordedById          Int
    cancelledAt           DateTime?                  @db.Timestamp(0)
    cancelledById         Int?
    cancellationReason    String?                    @db.Text
    createdAt             DateTime                   @default(now()) @db.Timestamp(0)
    updatedAt             DateTime                   @updatedAt
    order                 SalesOrders                @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
    recordedBy            Users                      @relation(name: "salesCompletionRecordsRecorded", fields: [recordedById], references: [id], onDelete: Restrict)
    cancelledBy           Users?                     @relation(name: "salesCompletionRecordsCancelled", fields: [cancelledById], references: [id], onDelete: Restrict)

    @@index([salesOrderId, state, milestone])
    @@index([completionMethod, recordedAt])
    @@index([milestone, effectiveAt])
    @@index([state, cancelledAt])
    @@index([recordedById, recordedAt])
    @@index([cancelledById, cancelledAt])
}

enum SalesPriority {
    CRITICAL
    HIGH
    NORMAL
    LOW
}

model SalesExtraCosts {
    id          Int                @unique @default(autoincrement())
    label       String
    type        SalesExtraCostType
    taxxable    Boolean?
    amount      Float
    tax         Float?
    totalAmount Float?
    percentage  Float?
    orderId     Int
    order       SalesOrders        @relation(fields: [orderId], references: [id])

    @@index([orderId])
}

enum SalesExtraCostType {
    Discount
    DiscountPercentage
    Labor
    FlatLabor
    CustomTaxxable
    CustomNonTaxxable
    Delivery
    EXT
}

model SalesOrderItems {
    id                 Int                              @unique @default(autoincrement())
    description        String?                          @db.VarChar(300)
    dykeDescription    String?                          @db.VarChar(300)
    productId          Int?
    supplier           String?
    swing              String?                          @db.VarChar(255)
    price              Float?
    tax                Float?
    taxPercenatage     Float?
    discount           Float?
    discountPercentage Float?
    meta               Json?                            @db.Json
    createdAt          DateTime?                        @default(now()) @db.Timestamp(0)
    updatedAt          DateTime?                        @updatedAt
    deletedAt          DateTime?                        @db.Timestamp(0)
    qty                Float?
    prebuiltQty        Float?
    truckLoadQty       Float?
    salesOrderId       Int
    profitMargin       Float?
    rate               Float?
    total              Float?
    salesPercentage    Float?
