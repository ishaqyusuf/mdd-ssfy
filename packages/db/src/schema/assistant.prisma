// Diagnostic references intentionally survive missing/deleted chats; reads reauthorize context.
model AssistantDiagnostic {
    reference       String   @id @db.VarChar(32)
    fingerprint     String   @db.Char(64)
    requestId       String?  @db.VarChar(191)
    conversationId  String?  @db.VarChar(191)
    runId           String?  @db.VarChar(191)
    toolCallId      String?  @db.VarChar(191)
    actorUserId     Int?
    scopeType       String?  @db.VarChar(32)
    scopeId         String?  @db.VarChar(191)
    stage           String   @db.VarChar(32)
    operation       String   @db.VarChar(120)
    code            String   @db.VarChar(100)
    severity        String   @db.VarChar(16)
    outcome         String   @db.VarChar(32)
    publicMessage   String   @db.VarChar(500)
    environment     String   @db.VarChar(32)
    release         String?  @db.VarChar(64)
    provider        String?  @db.VarChar(32)
    model           String?  @db.VarChar(100)
    durationMs      Int?
    details         Json?    @db.Json
    status          String   @default("new") @db.VarChar(20)
    createdAt       DateTime @default(now()) @db.DateTime(3)
    expiresAt       DateTime @db.DateTime(3)
    reviews         AssistantDiagnosticReview[]

    @@index([status, createdAt])
    @@index([fingerprint, createdAt])
    @@index([conversationId, createdAt])
    @@index([runId, createdAt])
    @@index([expiresAt])
}

model AssistantDiagnosticReview {
    id             String   @id @default(cuid()) @db.VarChar(191)
    reference      String   @db.VarChar(32)
    reviewerId     Int
    fromStatus     String   @db.VarChar(20)
    status         String   @db.VarChar(20)
    note           String   @db.Text
    createdAt      DateTime @default(now()) @db.DateTime(3)
    diagnostic     AssistantDiagnostic @relation(fields: [reference], references: [reference], onDelete: NoAction, onUpdate: NoAction)

    @@index([reference, createdAt])
}

model AssistantConversation {
    id             String             @id @default(cuid()) @db.VarChar(191)
    ownerUserId    Int
    scopeType      String             @default("user") @db.VarChar(50)
    scopeId        String?            @db.VarChar(191)
    title          String?            @db.VarChar(500)
    preferences    Json?              @db.Json
    lastSequence   Int                @default(0)
    retentionUntil DateTime?          @db.Timestamp(0)
    archivedAt     DateTime?          @db.Timestamp(0)
    deletedAt      DateTime?          @db.Timestamp(0)
    createdAt      DateTime           @default(now()) @db.Timestamp(0)
    updatedAt      DateTime           @updatedAt
    messages       AssistantMessage[]
    runs           AssistantRun[]
    featureRequests AssistantFeatureRequest[]
    salesRequestSession AssistantSalesRequestSession?

    @@index([ownerUserId, archivedAt, deletedAt, updatedAt], map: "asst_conv_owner_active_idx")
    @@index([ownerUserId, scopeType, scopeId, deletedAt], map: "asst_conv_scope_idx")
    @@index([retentionUntil, deletedAt], map: "asst_conv_retention_idx")
}

/// Private source, clarification and final preview for one Sales Request conversation.
model AssistantSalesRequestSession {
    id                    String                @id @default(cuid()) @db.VarChar(191)
    conversationId        String                @unique(map: "asst_sales_request_conversation_uq") @db.VarChar(191)
    ownerUserId           Int
    scopeType             String                @db.VarChar(50)
    scopeId               String                @db.VarChar(191)
    saleType              String                @db.VarChar(16)
    sourceText            String                @db.LongText
    sourceFingerprint     String                @db.Char(64)
    requestId             String                @db.VarChar(191)
    provider              String                @db.VarChar(40)
    model                 String                @db.VarChar(100)
    status                String                @default("processing") @db.VarChar(24)
    revision              Int                   @default(1)
    clarificationId       String?               @db.VarChar(36)
    generationId          String?               @db.VarChar(36)
    pendingPreview        Json?                 @db.Json
    finalPreview          Json?                 @db.Json
    errorMessage          String?               @db.VarChar(500)
    completedAt           DateTime?             @db.Timestamp(0)
    createdAt             DateTime              @default(now()) @db.Timestamp(0)
    updatedAt             DateTime              @updatedAt
    conversation          AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@unique([ownerUserId, requestId], map: "asst_sales_request_idempotency_uq")
    @@index([ownerUserId, scopeType, scopeId, status], map: "asst_sales_request_owner_scope_idx")
    @@index([generationId, ownerUserId], map: "asst_sales_request_generation_owner_idx")
}

model AssistantUserEntitlement {
    id              String                      @id @default(cuid()) @db.VarChar(191)
    userId          Int                         @unique(map: "asst_entitlement_user_uq")
    enabled         Boolean                     @default(false)
    expiresAt       DateTime?                   @db.Timestamp(0)
    reason          String?                     @db.VarChar(500)
    createdByUserId Int
    updatedByUserId Int
    version         Int                         @default(1)
    createdAt       DateTime                    @default(now()) @db.Timestamp(0)
    updatedAt       DateTime                    @updatedAt
    user            Users                       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    events          AssistantEntitlementEvent[]

    @@index([enabled, expiresAt, updatedAt], map: "asst_entitlement_state_idx")
    @@index([updatedByUserId, updatedAt], map: "asst_entitlement_admin_idx")
}

model AssistantRuntimeSetting {
    key             String                         @id @db.VarChar(50)
    provider        String                         @db.VarChar(40)
    model           String                         @db.VarChar(100)
    version         Int                            @default(1)
    updatedByUserId Int
    createdAt       DateTime                       @default(now()) @db.Timestamp(0)
    updatedAt       DateTime                       @updatedAt
}

model AssistantRuntimeSettingEvent {
    id          String                  @id @default(cuid()) @db.VarChar(191)
    settingKey  String                  @db.VarChar(50)
    provider    String                  @db.VarChar(40)
    model       String                  @db.VarChar(100)
    version     Int
    actorUserId Int
    createdAt   DateTime                @default(now()) @db.Timestamp(0)

    @@unique([settingKey, version], map: "asst_runtime_setting_event_version_uq")
    @@index([actorUserId, createdAt], map: "asst_runtime_setting_event_actor_idx")
}

model AssistantEntitlementEvent {
    id              String                   @id @default(cuid()) @db.VarChar(191)
    entitlementId   String                   @db.VarChar(191)
    userId          Int
    type            String                   @db.VarChar(32)
    enabled         Boolean
    expiresAt       DateTime?                @db.Timestamp(0)
    reason          String?                  @db.VarChar(500)
    actorUserId     Int?
    entitlementVersion Int
    createdAt       DateTime                 @default(now()) @db.Timestamp(0)
    entitlement     AssistantUserEntitlement @relation(fields: [entitlementId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@unique([entitlementId, entitlementVersion], map: "asst_entitlement_event_version_uq")
    @@index([userId, createdAt], map: "asst_entitlement_event_user_idx")
    @@index([actorUserId, createdAt], map: "asst_entitlement_event_actor_idx")
}

model AssistantFeatureRequest {
    id                 String   @id @default(cuid()) @db.VarChar(191)
    ownerUserId        Int
    scopeType          String   @db.VarChar(50)
    scopeId            String   @db.VarChar(191)
    conversationId     String?  @db.VarChar(191)
    canonicalKey       String   @db.Char(64)
    summary            String   @db.VarChar(500)
    category           String   @db.VarChar(50)
    capabilityKey      String?  @db.VarChar(191)
    classifierVersion  String   @db.VarChar(64)
    status             String   @default("submitted") @db.VarChar(32)
    occurrenceCount    Int      @default(1)
    lastEventSequence  Int      @default(0)
    analysisStatus     String   @default("queued") @db.VarChar(32)
    analysis            Json?    @db.Json
    analysisRevision   String?   @db.VarChar(64)
    knowledgeSnapshot  Json      @db.Json
    assignedToUserId   Int?
    mergedIntoId       String?   @db.VarChar(191)
    releaseId          String?   @db.VarChar(191)
    reviewedAnalysisAt DateTime? @db.Timestamp(0)
    reviewedByUserId   Int?
    createdAt          DateTime  @default(now()) @db.Timestamp(0)
    updatedAt          DateTime  @updatedAt
    conversation       AssistantConversation? @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    mergedInto         AssistantFeatureRequest? @relation("assistantFeatureRequestMerge", fields: [mergedIntoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    mergedRequests     AssistantFeatureRequest[] @relation("assistantFeatureRequestMerge")
    release            AssistantCapabilityRelease? @relation(fields: [releaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    submissions        AssistantFeatureRequestSubmission[]
    subscriptions      AssistantFeatureSubscription[]
    events             AssistantFeatureRequestEvent[]
    analysisJobs       AssistantFeatureAnalysisJob[]
    outbox             AssistantFeatureNotificationOutbox[]

    @@unique([scopeType, scopeId, canonicalKey], map: "asst_feature_request_scope_key_uq")
    @@index([scopeType, scopeId, status, updatedAt], map: "asst_feature_request_scope_status_idx")
    @@index([analysisStatus, updatedAt], map: "asst_feature_request_analysis_idx")
    @@index([assignedToUserId, status, updatedAt], map: "asst_feature_request_owner_idx")
    @@index([conversationId, createdAt], map: "asst_feature_request_conversation_idx")
    @@index([mergedIntoId], map: "asst_feature_request_merge_idx")
    @@index([releaseId], map: "asst_feature_request_release_idx")
}

model AssistantFeatureRequestSubmission {
    id                 String   @id @default(cuid()) @db.VarChar(191)
    requestId          String   @db.VarChar(191)
    reporterUserId     Int
    scopeType          String   @db.VarChar(50)
    scopeId            String   @db.VarChar(191)
    clientRequestId    String   @db.VarChar(191)
    summary            String   @db.VarChar(500)
    evidence           Json     @db.Json
    consentVersion     String   @db.VarChar(64)
    releaseOptIn       Boolean  @default(false)
    createdAt          DateTime @default(now()) @db.Timestamp(0)
    request            AssistantFeatureRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@unique([reporterUserId, scopeType, scopeId, clientRequestId], map: "asst_feature_submission_request_uq")
    @@index([reporterUserId, scopeType, scopeId, createdAt], map: "asst_feature_submission_reporter_idx")
    @@index([requestId, createdAt], map: "asst_feature_submission_feature_idx")
}

model AssistantFeatureSubscription {
    id               String    @id @default(cuid()) @db.VarChar(191)
    requestId        String    @db.VarChar(191)
    userId           Int
    scopeType        String    @db.VarChar(50)
    scopeId          String    @db.VarChar(191)
    consentVersion   String    @db.VarChar(64)
    consentEvidence  Json      @db.Json
    activeKey        String    @default("active") @db.VarChar(191)
    unsubscribedAt   DateTime? @db.Timestamp(0)
    createdAt        DateTime  @default(now()) @db.Timestamp(0)
    updatedAt        DateTime  @updatedAt
    request          AssistantFeatureRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    outbox            AssistantFeatureNotificationOutbox[]

    @@unique([requestId, userId, scopeType, scopeId, activeKey], map: "asst_feature_subscription_active_uq")
    @@index([userId, scopeType, scopeId, unsubscribedAt], map: "asst_feature_subscription_user_idx")
}

model AssistantFeatureRequestEvent {
    id          String   @id @default(cuid()) @db.VarChar(191)
    requestId   String   @db.VarChar(191)
    sequence    Int
    type        String   @db.VarChar(50)
    actorUserId Int?
    payload     Json?    @db.Json
    createdAt   DateTime @default(now()) @db.Timestamp(0)
    request     AssistantFeatureRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@unique([requestId, sequence], map: "asst_feature_event_sequence_uq")
    @@index([requestId, createdAt], map: "asst_feature_event_request_idx")
}

model AssistantFeatureAnalysisJob {
    id                String    @id @default(cuid()) @db.VarChar(191)
    requestId         String    @db.VarChar(191)
    revision          Int       @default(1)
    status            String    @default("queued") @db.VarChar(32)
    attempts          Int       @default(0)
    maxAttempts       Int       @default(3)
    claimedAt         DateTime? @db.Timestamp(0)
    completedAt       DateTime? @db.Timestamp(0)
    lastErrorCode     String?   @db.VarChar(100)
    createdAt         DateTime  @default(now()) @db.Timestamp(0)
    updatedAt         DateTime  @updatedAt
    request           AssistantFeatureRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@unique([requestId, revision], map: "asst_feature_analysis_revision_uq")
    @@index([status, createdAt], map: "asst_feature_analysis_queue_idx")
}

model AssistantCapabilityRelease {
    id                String    @id @default(cuid()) @db.VarChar(191)
    capabilityKey     String    @db.VarChar(191)
    version           String    @db.VarChar(64)
    title             String    @db.VarChar(200)
    status            String    @default("draft") @db.VarChar(32)
    requiredGrants    Json      @db.Json
    rolloutEvidence   Json?     @db.Json
    verifiedAt        DateTime? @db.Timestamp(0)
    verifiedByUserId  Int?
    publishedAt       DateTime? @db.Timestamp(0)
    publishedByUserId Int?
    createdAt         DateTime  @default(now()) @db.Timestamp(0)
    updatedAt         DateTime  @updatedAt
    requests          AssistantFeatureRequest[]
    outbox            AssistantFeatureNotificationOutbox[]

    @@unique([capabilityKey, version], map: "asst_capability_release_version_uq")
    @@index([status, verifiedAt, publishedAt], map: "asst_capability_release_status_idx")
}

model AssistantFeatureNotificationOutbox {
    id             String    @id @default(cuid()) @db.VarChar(191)
    requestId      String    @db.VarChar(191)
    subscriptionId String?   @db.VarChar(191)
    releaseId      String?   @db.VarChar(191)
    kind           String    @db.VarChar(40)
    dedupeKey      String    @unique(map: "asst_feature_notice_dedupe_uq") @db.Char(64)
    status         String    @default("pending") @db.VarChar(32)
    attempts       Int       @default(0)
    availableAt    DateTime  @default(now()) @db.Timestamp(0)
    deliveredAt    DateTime? @db.Timestamp(0)
    lastErrorCode  String?   @db.VarChar(100)
    createdAt      DateTime  @default(now()) @db.Timestamp(0)
    updatedAt      DateTime  @updatedAt
    request        AssistantFeatureRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    subscription   AssistantFeatureSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    release        AssistantCapabilityRelease? @relation(fields: [releaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@index([status, availableAt], map: "asst_feature_notice_queue_idx")
    @@index([requestId, kind, createdAt], map: "asst_feature_notice_request_idx")
    @@index([subscriptionId], map: "asst_feature_notice_subscription_idx")
    @@index([releaseId], map: "asst_feature_notice_release_idx")
}

model AssistantMessage {
    id              String                @id @default(cuid()) @db.VarChar(191)
    conversationId  String                @db.VarChar(191)
    sequence        Int
    role            String                @db.VarChar(20)
    parts           Json                  @db.Json
    searchText      String?               @db.Text
    clientRequestId String?               @db.VarChar(191)
    requestFingerprint String?            @db.Char(64)
    generatedRunId  String?               @unique(map: "asst_msg_generated_run_uq") @db.VarChar(191)
    parentMessageId String?               @db.VarChar(191)
    createdByUserId Int?
    createdAt       DateTime              @default(now()) @db.Timestamp(0)
    conversation    AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    parentMessage   AssistantMessage?     @relation("assistantMessageReplies", fields: [parentMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    replies         AssistantMessage[]    @relation("assistantMessageReplies")
    runs            AssistantRun[]        @relation("assistantRunTrigger")

    @@unique([conversationId, sequence], map: "asst_msg_seq_uq")
    @@unique([conversationId, clientRequestId], map: "asst_msg_request_uq")
    @@index([conversationId, createdAt], map: "asst_msg_created_idx")
    @@index([parentMessageId], map: "asst_msg_parent_idx")
    @@index([createdByUserId, createdAt], map: "asst_msg_actor_idx")
}

model AssistantRun {
    id               String                   @id @default(cuid()) @db.VarChar(191)
    conversationId   String                   @db.VarChar(191)
    triggerMessageId String?                  @db.VarChar(191)
    actorUserId      Int
    requestId        String                   @db.VarChar(191)
    requestFingerprint String                 @db.Char(64)
    catalogVersion   String                   @db.VarChar(64)
    model            String                   @db.VarChar(100)
    promptVersion    String                   @db.VarChar(64)
    status           String                   @default("queued") @db.VarChar(32)
    checkpoint       Json?                    @db.Json
    terminalResult   Json?                    @db.Json
    usage            Json?                    @db.Json
    lastSequence     Int                      @default(0)
    errorCode        String?                  @db.VarChar(100)
    errorMessage     String?                  @db.Text
    startedAt        DateTime?                @db.Timestamp(0)
    completedAt      DateTime?                @db.Timestamp(0)
    createdAt        DateTime                 @default(now()) @db.Timestamp(0)
    updatedAt        DateTime                 @updatedAt
    conversation     AssistantConversation    @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    triggerMessage   AssistantMessage?        @relation("assistantRunTrigger", fields: [triggerMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    toolExecutions   AssistantToolExecution[]
    actionProposals  AssistantActionProposal[]
    usageEvents      AssistantUsageEvent[]

    @@unique([actorUserId, requestId], map: "asst_run_request_uq")
    @@index([conversationId, status, createdAt], map: "asst_run_status_idx")
    @@index([conversationId, updatedAt], map: "asst_run_updated_idx")
    @@index([triggerMessageId], map: "asst_run_trigger_idx")
}

model AssistantUsageEvent {
    id                  String       @id @default(cuid()) @db.VarChar(191)
    runId               String       @db.VarChar(191)
    providerRequestId   String       @unique(map: "asst_usage_provider_request_uq") @db.VarChar(191)
    actorUserId         Int
    scopeType           String       @db.VarChar(50)
    scopeId             String       @db.VarChar(191)
    provider            String       @db.VarChar(40)
    model               String       @db.VarChar(100)
    requestClass        String       @default("chat") @db.VarChar(40)
    inputTokens         Int?
    cachedInputTokens   Int?
    outputTokens        Int?
    reasoningTokens     Int?
    totalTokens         Int?
    toolCallCount       Int          @default(0)
    durationMs          Int?
    outcome             String       @db.VarChar(32)
    estimatedCostMicros BigInt?
    priceVersion        String?      @db.VarChar(64)
    accountingStatus    String       @default("unknown") @db.VarChar(32)
    reconciledAt        DateTime?    @db.Timestamp(0)
    startedAt           DateTime?    @db.Timestamp(0)
    completedAt         DateTime     @db.Timestamp(0)
    createdAt           DateTime     @default(now()) @db.Timestamp(0)
    run                 AssistantRun @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    reconciliations     AssistantUsageReconciliation[]

    @@index([actorUserId, completedAt], map: "asst_usage_actor_time_idx")
    @@index([runId, completedAt], map: "asst_usage_run_time_idx")
    @@index([scopeType, scopeId, completedAt], map: "asst_usage_scope_time_idx")
    @@index([provider, model, completedAt], map: "asst_usage_model_time_idx")
    @@index([outcome, completedAt], map: "asst_usage_outcome_time_idx")
}

model AssistantModelPrice {
    id                        String    @id @default(cuid()) @db.VarChar(191)
    provider                  String    @db.VarChar(40)
    model                     String    @db.VarChar(100)
    version                   String    @db.VarChar(64)
    inputPerMillionMicros     BigInt
    cachedPerMillionMicros    BigInt
    outputPerMillionMicros    BigInt
    reasoningPerMillionMicros BigInt
    effectiveFrom             DateTime  @db.Timestamp(0)
    effectiveTo               DateTime? @db.Timestamp(0)
    createdByUserId           Int
    createdAt                 DateTime  @default(now()) @db.Timestamp(0)

    @@unique([provider, model, version], map: "asst_price_model_version_uq")
    @@index([provider, model, effectiveFrom], map: "asst_price_effective_idx")
}

model AssistantUsageReconciliation {
    id             String              @id @default(cuid()) @db.VarChar(191)
    usageEventId   String              @db.VarChar(191)
    actorUserId    Int?
    previousUsage  Json
    nextUsage      Json
    note           String              @db.Text
    createdAt      DateTime            @default(now()) @db.Timestamp(0)
    usageEvent     AssistantUsageEvent @relation(fields: [usageEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@index([usageEventId, createdAt], map: "asst_usage_reconcile_event_idx")
}

model AssistantQuotaPolicy {
    id                     String    @id @default(cuid()) @db.VarChar(191)
    userId                 Int?
    name                   String    @db.VarChar(120)
    kind                   String    @default("user") @db.VarChar(32)
    sourceTemplateId       String?   @db.VarChar(191)
    dailyRequestLimit      Int?
    monthlyRequestLimit    Int?
    dailyTokenLimit        BigInt?
    monthlyTokenLimit      BigInt?
    concurrentRunLimit     Int?
    dailyCostLimitMicros   BigInt?
    monthlyCostLimitMicros BigInt?
    warningPercent         Int       @default(80)
    timezone               String    @default("UTC") @db.VarChar(64)
    enforcementMode        String    @default("hard") @db.VarChar(24)
    effectiveFrom          DateTime  @db.Timestamp(0)
    effectiveTo            DateTime? @db.Timestamp(0)
    createdByUserId        Int
    updatedByUserId        Int
    version                Int       @default(1)
    createdAt              DateTime  @default(now()) @db.Timestamp(0)
    updatedAt              DateTime  @updatedAt

    @@index([userId, effectiveFrom, effectiveTo], map: "asst_quota_user_effective_idx")
    @@index([kind, effectiveFrom, effectiveTo], map: "asst_quota_kind_effective_idx")
    @@index([sourceTemplateId], map: "asst_quota_template_idx")
}

model AssistantQuotaReservation {
    id                 String    @id @default(cuid()) @db.VarChar(191)
    runId              String    @unique(map: "asst_quota_reservation_run_uq") @db.VarChar(191)
    actorUserId        Int
    scopeType          String    @db.VarChar(50)
    scopeId            String    @db.VarChar(191)
    policyId           String?   @db.VarChar(191)
    policySnapshot     Json      @db.Json
    status             String    @default("reserved") @db.VarChar(24)
    requestUnits       Int       @default(1)
    reservedTokens     BigInt    @default(0)
    reservedCostMicros BigInt    @default(0)
    actualTokens       BigInt?
    actualCostMicros   BigInt?
    dayWindowStart     DateTime  @db.Timestamp(0)
    monthWindowStart   DateTime  @db.Timestamp(0)
    expiresAt          DateTime  @db.Timestamp(0)
    settledAt          DateTime? @db.Timestamp(0)
    createdAt          DateTime  @default(now()) @db.Timestamp(0)
    updatedAt          DateTime  @updatedAt

    @@index([actorUserId, dayWindowStart, status], map: "asst_quota_actor_day_idx")
    @@index([actorUserId, monthWindowStart, status], map: "asst_quota_actor_month_idx")
    @@index([actorUserId, status, expiresAt], map: "asst_quota_actor_active_idx")
    @@index([policyId, createdAt], map: "asst_quota_policy_usage_idx")
}

model AssistantToolExecution {
    id               String       @id @default(cuid()) @db.VarChar(191)
    runId            String       @db.VarChar(191)
    toolCallId       String       @db.VarChar(191)
    step             Int
    ordinal          Int          @default(0)
    eventSequence    Int
    toolId           String       @db.VarChar(191)
    toolVersion      Int
    effect           String       @db.VarChar(32)
    status           String       @default("running") @db.VarChar(32)
    inputFingerprint String       @db.Char(64)
    input            Json?        @db.Json
    result           Json?        @db.Json
    errorCode        String?      @db.VarChar(100)
    durationMs       Int?
    idempotencyKey   String?      @unique(map: "asst_tool_idempotency_uq") @db.VarChar(191)
    startedAt        DateTime     @default(now()) @db.Timestamp(0)
    completedAt      DateTime?    @db.Timestamp(0)
    createdAt        DateTime     @default(now()) @db.Timestamp(0)
    updatedAt        DateTime     @updatedAt
    run              AssistantRun @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@unique([runId, toolCallId], map: "asst_tool_call_uq")
    @@unique([runId, step, ordinal], map: "asst_tool_step_uq")
    @@unique([runId, eventSequence], map: "asst_tool_event_uq")
    @@index([runId, status, createdAt], map: "asst_tool_status_idx")
    @@index([toolId, toolVersion, createdAt], map: "asst_tool_version_idx")
}

model AssistantActionProposal {
    id               String       @id @default(cuid()) @db.VarChar(191)
    runId            String       @db.VarChar(191)
    actorUserId      Int
    toolId           String       @db.VarChar(191)
    toolVersion      Int
    effect           String       @db.VarChar(32)
    payloadHash      String       @db.Char(64)
    payload          Json         @db.Json
    targetRevision   String?      @db.VarChar(191)
    diff             Json?        @db.Json
    status           String       @default("pending") @db.VarChar(32)
    expiresAt        DateTime     @db.Timestamp(0)
    nonceHash        String       @unique(map: "asst_proposal_nonce_uq") @db.Char(64)
    idempotencyKey   String       @db.VarChar(191)
    eventSequence    Int
    confirmedAt      DateTime?    @db.Timestamp(0)
    confirmationRequestId String? @unique(map: "asst_proposal_confirmation_request_uq") @db.VarChar(191)
    executionStartedAt DateTime?  @db.Timestamp(0)
    executionCompletedAt DateTime? @db.Timestamp(0)
    consumedAt       DateTime?    @db.Timestamp(0)
    rejectedAt       DateTime?    @db.Timestamp(0)
    result           Json?        @db.Json
    errorCode        String?      @db.VarChar(100)
    createdAt        DateTime     @default(now()) @db.Timestamp(0)
    updatedAt        DateTime     @updatedAt
    run              AssistantRun @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@unique([actorUserId, idempotencyKey], map: "asst_proposal_idempotency_uq")
    @@unique([runId, eventSequence], map: "asst_proposal_event_uq")
    @@index([runId, status, createdAt], map: "asst_proposal_run_idx")
    @@index([actorUserId, status, expiresAt], map: "asst_proposal_actor_idx")
    @@index([toolId, toolVersion, createdAt], map: "asst_proposal_tool_idx")
}

model AssistantPreference {
    id               String   @id @default(cuid()) @db.VarChar(191)
    ownerUserId      Int
    scopeType        String   @default("user") @db.VarChar(50)
    scopeId          String   @db.VarChar(191)
    responseStyle    String   @default("balanced") @db.VarChar(32)
    responseDetail   String   @default("standard") @db.VarChar(32)
    chartPresentation String  @default("auto") @db.VarChar(32)
    version          Int      @default(1)
    createdAt        DateTime @default(now()) @db.Timestamp(0)
    updatedAt        DateTime @updatedAt

    @@unique([ownerUserId, scopeType, scopeId], map: "asst_pref_owner_scope_uq")
    @@index([ownerUserId, updatedAt], map: "asst_pref_owner_idx")
}

model AssistantPersonalMemory {
    id          String    @id @default(cuid()) @db.VarChar(191)
    ownerUserId Int
    scopeType   String    @default("user") @db.VarChar(50)
    scopeId     String    @db.VarChar(191)
    content     String    @db.VarChar(500)
    version     Int       @default(1)
    deletedAt   DateTime? @db.Timestamp(0)
    createdAt   DateTime  @default(now()) @db.Timestamp(0)
    updatedAt   DateTime  @updatedAt

    @@index([ownerUserId, scopeType, scopeId, deletedAt, updatedAt], map: "asst_memory_scope_idx")
}

model AssistantSavedAction {
    id                    String    @id @default(cuid()) @db.VarChar(191)
    ownerUserId           Int
    scopeType             String    @default("user") @db.VarChar(50)
    scopeId               String    @db.VarChar(191)
    name                  String    @db.VarChar(120)
    kind                  String    @db.VarChar(24)
    promptTemplate        String?   @db.Text
    toolId                String?   @db.VarChar(191)
    toolVersion           Int?
    effect                String?   @db.VarChar(32)
    inputTemplate         Json?     @db.Json
    parameterDefinitions  Json?     @db.Json
    outputBindings        Json?     @db.Json
    compatibilityRevision String    @db.VarChar(191)
    activeKey             String    @default("active") @db.VarChar(191)
    displayOrder          Int       @default(0)
    version               Int       @default(1)
    lastRunStatus         String?   @db.VarChar(32)
    lastRunAt             DateTime? @db.Timestamp(0)
    deletedAt             DateTime? @db.Timestamp(0)
    createdAt             DateTime  @default(now()) @db.Timestamp(0)
    updatedAt             DateTime  @updatedAt

    @@unique([ownerUserId, scopeType, scopeId, name, activeKey], map: "asst_saved_action_name_uq")
    @@index([ownerUserId, scopeType, scopeId, deletedAt, displayOrder], map: "asst_saved_action_scope_idx")
    @@index([toolId, toolVersion, deletedAt], map: "asst_saved_action_tool_idx")
}
