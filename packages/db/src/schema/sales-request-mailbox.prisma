  @@unique([connectionId, providerMessageIdentityHash], name: "sales_req_mailbox_lease_uq")
  @@index([status, nextAttemptAt, leaseExpiresAt], name: "sales_req_mailbox_lease_due_idx")
  @@index([leaseId, leaseEpoch], name: "sales_req_mailbox_lease_fence_idx")
}

model SalesRequestMailboxSourceMembership {
  id                String    @id @db.VarChar(69)
  connectionId      String    @db.VarChar(191)
  sourceId          String    @db.VarChar(191)
  messageSummaryId  String    @db.VarChar(191)
  snapshotId                  String    @db.VarChar(191)
  providerMessageId           String    @db.VarChar(255)
  providerMessageIdentityHash String    @db.Char(64)
  summaryRevision   Int
  state             String    @default("active") @db.VarChar(32)
  activeKey         String?   @unique(map: "sales_req_mailbox_membership_active_uq") @db.VarChar(512)
  activatedAt       DateTime  @default(now()) @db.DateTime(3)
  deactivatedAt     DateTime? @db.DateTime(3)
  withdrawalReason  String?   @db.VarChar(80)
  createdAt         DateTime  @default(now()) @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @db.DateTime(3)

  @@unique([sourceId, providerMessageIdentityHash, summaryRevision], name: "sales_req_mailbox_membership_revision_uq")
  @@index([connectionId, providerMessageIdentityHash, state], name: "sales_req_mailbox_membership_active_idx")
  @@index([snapshotId, state], name: "sales_req_mailbox_membership_snapshot_idx")
}

model SalesRequestMailboxMessageSnapshot {
  id                String   @id @default(cuid()) @db.VarChar(191)
  connectionId      String   @db.VarChar(191)
  provider          String   @db.VarChar(32)
  providerMessageId           String   @db.VarChar(255)
  providerMessageIdentityHash String   @db.Char(64)
  providerThreadId  String?  @db.VarChar(255)
  schemaVersion     Int      @default(1)
  contentHash       String   @db.VarChar(69)
  capturedAt        DateTime @db.DateTime(3)
  receivedAt        DateTime @db.DateTime(3)
  expiresAt         DateTime @db.DateTime(3)
  fromEmail         String   @db.VarChar(320)
  fromName          String?  @db.VarChar(255)
  subject           String?  @db.VarChar(998)
  toEmails          Json
  ccEmails          Json
  hasAttachments    Boolean  @default(false)
  displayText       String   @db.LongText
  modelInput        String   @db.LongText
  createdAt         DateTime @default(now()) @db.DateTime(3)

  @@unique([connectionId, providerMessageIdentityHash, schemaVersion, contentHash], name: "sales_req_mailbox_snapshot_uq")
  @@index([expiresAt], name: "sales_req_mailbox_snapshot_expiry_idx")
  @@index([connectionId, providerMessageIdentityHash, receivedAt], name: "sales_req_mailbox_snapshot_message_idx")
}

model SalesRequestMailboxQueueProjection {
  id                    String    @id @default(cuid()) @db.VarChar(191)
  queueIdentity         String    @unique(map: "sales_req_mailbox_queue_identity_uq") @db.VarChar(80)
  connectionId          String    @db.VarChar(191)
  organizationId        Int
  ownerUserId           Int
  provider              String    @db.VarChar(32)
  providerMessageId     String    @db.VarChar(255)
  providerMessageIdentityHash String @db.Char(64)
  snapshotId            String    @db.VarChar(191)
  sourceMembershipId    String    @db.VarChar(69)
  sourceKey             String    @db.VarChar(255)
  sourceSummaryRevision Int
  snapshotSchemaVersion Int       @default(1)
  contentHash           String    @db.VarChar(69)
  status                String    @default("new") @db.VarChar(32)
  statusRevision        Int       @default(1)
  statusUpdatedAt       DateTime  @default(now()) @db.DateTime(3)
  failureCode           String?   @db.VarChar(80)
  receivedAt            DateTime  @db.DateTime(3)
  fromEmail             String    @db.VarChar(320)
  fromName              String?   @db.VarChar(255)
  subject               String?   @db.VarChar(998)
  hasAttachments        Boolean   @default(false)
  withdrawnAt           DateTime? @db.DateTime(3)
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @db.DateTime(3)

  @@unique([connectionId, providerMessageIdentityHash], name: "sales_req_mailbox_current_queue_uq")
  @@index([ownerUserId, organizationId, connectionId, status, receivedAt, queueIdentity], name: "sales_req_mailbox_inbox_idx")
  @@index([ownerUserId, organizationId, connectionId, receivedAt, queueIdentity], name: "sales_req_mailbox_inbox_all_idx")
  @@index([snapshotId], name: "sales_req_mailbox_queue_snapshot_idx")
  @@index([sourceMembershipId], name: "sales_req_mailbox_queue_membership_idx")
}
