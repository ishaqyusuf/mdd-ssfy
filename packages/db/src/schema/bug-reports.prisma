enum BugReportStatus {
    NEW
    IN_REVIEW
    IN_PROGRESS
    NEEDS_INFO
    FIXED
    CLOSED
}

enum BugReportCaptureType {
    VIDEO
    SCREENSHOT
}

enum BugReportTranscriptionStatus {
    NOT_REQUESTED
    PENDING
    COMPLETED
    FAILED
}

enum BugReportUploadMediaKind {
    VIDEO
    SCREENSHOT
    AUDIO
}

enum BugReportUploadIntentState {
    PENDING
    READY
    CONSUMED
    EXPIRED
}

enum BugReportDeliveryState {
    PENDING
    PROCESSING
    CREATED
    RETRY_WAIT
    FAILED
    UNCONFIGURED
    UNCERTAIN
}

model BugReport {
    id                  String          @id @default(cuid())
    createdById         Int
    status              BugReportStatus @default(NEW)
    captureType         BugReportCaptureType @default(VIDEO)
    description         String?         @db.Text
    currentUrl          String?         @db.VarChar(2048)
    userAgent           String?         @db.Text
    submissionId        String?         @db.VarChar(64)
    submissionFingerprint String?       @db.VarChar(191)
    source              String          @default("web") @db.VarChar(50)
    recordingDocumentId String?         @db.VarChar(191)
    durationMs          Int?
    microphoneEnabled   Boolean         @default(false)
    externalIssueProvider String?        @db.VarChar(50)
    externalIssueKey    String?         @db.VarChar(191)
    externalIssueUrl    String?         @db.VarChar(512)
    externalIssueStatus String?         @db.VarChar(50)
    externalIssueError  String?         @db.Text
    externalIssueCreatedAt DateTime?    @db.Timestamp(0)
    statusUpdatedById   Int?
    statusUpdatedAt     DateTime?       @db.Timestamp(0)
    createdAt           DateTime?       @default(now()) @db.Timestamp(0)
    updatedAt           DateTime?       @updatedAt
    deletedAt           DateTime?       @db.Timestamp(0)
    followUps           BugReportFollowUp[]
    uploadIntents       BugReportUploadIntent[]
    delivery            BugReportDelivery?

    @@index([createdById, createdAt])
    @@unique([createdById, submissionId])
    @@index([status, createdAt])
    @@index([recordingDocumentId])
    @@index([externalIssueProvider, externalIssueKey])
    @@index([externalIssueStatus, createdAt])
    @@index([deletedAt])
}

model BugReportFollowUp {
    id                  String    @id @default(cuid())
    bugReportId         String
    authorId            Int
    body                String    @db.Text
    audioDocumentId     String?   @db.VarChar(191)
    audioDurationMs     Int?
    transcriptionStatus BugReportTranscriptionStatus @default(NOT_REQUESTED)
    transcriptionText   String?   @db.Text
    transcriptionProvider String? @db.VarChar(100)
    createdAt           DateTime? @default(now()) @db.Timestamp(0)
    updatedAt           DateTime? @updatedAt
    deletedAt           DateTime? @db.Timestamp(0)
    bugReport           BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)

    @@index([bugReportId, createdAt])
    @@index([authorId, createdAt])
    @@index([audioDocumentId])
    @@index([transcriptionStatus, createdAt])
    @@index([deletedAt])
}

model BugReportUploadIntent {
    id                  String   @id @default(cuid())
    createdById         Int
    mediaKind           BugReportUploadMediaKind
    pathname            String   @unique @db.VarChar(512)
    expectedMimeType    String   @db.VarChar(255)
    expectedSize        Int
    verifiedMimeType    String?  @db.VarChar(255)
    verifiedSize        Int?
    verifiedStorageUrl  String?  @db.VarChar(512)
    state               BugReportUploadIntentState @default(PENDING)
    expiresAt           DateTime @db.Timestamp(0)
    consumedReportId    String?  @db.VarChar(191)
    createdAt           DateTime? @default(now()) @db.Timestamp(0)
    updatedAt           DateTime? @updatedAt
    report              BugReport? @relation(fields: [consumedReportId], references: [id])

    @@index([createdById, state, expiresAt])
    @@index([consumedReportId])
}

model BugReportDelivery {
    id                  String   @id @default(cuid())
    reportId           String   @unique @db.VarChar(191)
    provider           String   @db.VarChar(50)
    repository          String   @db.VarChar(191)
    actionKey           String   @unique @db.VarChar(191)
    state               BugReportDeliveryState @default(PENDING)
    attempts            Int      @default(0)
    nextAttemptAt       DateTime? @db.Timestamp(0)
    leaseId             String?  @db.VarChar(191)
    leaseExpiresAt      DateTime? @db.Timestamp(0)
    lastErrorCode       String?  @db.VarChar(100)
    remoteIssueNumber   Int?
    remoteIssueKey      String?  @db.VarChar(191)
    remoteIssueUrl      String?  @db.VarChar(512)
    scanCursor          String?  @db.VarChar(191)
    scanCompletedAt     DateTime? @db.Timestamp(0)
    firstAttemptAt      DateTime? @db.Timestamp(0)
    lastAttemptAt       DateTime? @db.Timestamp(0)
    sentAt              DateTime? @db.Timestamp(0)
    createdAt           DateTime? @default(now()) @db.Timestamp(0)
    updatedAt           DateTime? @updatedAt
    report              BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

    @@index([state, nextAttemptAt])
    @@index([provider, repository])
    @@index([leaseExpiresAt])
}
