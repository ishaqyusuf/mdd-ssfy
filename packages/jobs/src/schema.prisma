model LineItem {
    id          Int     @id @default(autoincrement())
    uid         String? //a line item may have multiple other records, same uid will be used to keep the record
    sn          Int?    @default(0) // index
    title       String?
    description String?
    qty         Float?  @default(1)
    unitCost    Float?
    totalCost   Float?
    meta        Json? // for keeping other metadata eg; swing, handle

    guestId String?
    userId  Int?

    createdAt DateTime? @default(now()) @db.Timestamp(0)
    updatedAt DateTime? @updatedAt
    deletedAt DateTime? @db.Timestamp(0)

    lineItemType LineItemType

    variant            InventoryVariant @relation(fields: [inventoryVariantId], references: [id])
    inventoryVariantId Int

    wishtListItem   WisthListItem? @relation(fields: [wisthListItemId], references: [id])
    wisthListItemId Int?
    // cartItem           CartItem?        @relation(fields: [cartItemId], references: [id])
    // cartItemId         Int?
    sale            SalesOrders?   @relation(fields: [saleId], references: [id])
    saleId          Int?

    salesItemId Int? @unique

    salesItem SalesOrderItems? @relation(fields: [salesItemId], references: [id])

    components LineItemComponents[]
    price      LinePricing?

    inventory   Inventory @relation(fields: [inventoryId], references: [id])
    inventoryId Int

    inventoryCategory   InventoryCategory @relation(fields: [inventoryCategoryId], references: [id])
    inventoryCategoryId Int

    @@index([inventoryVariantId])
    @@index([wisthListItemId])
    @@index([inventoryCategoryId])
    @@index([saleId])
    @@index([inventoryId])
    @@index([saleId, deletedAt, lineItemType, id], name: "idx_line_item_fulfillment_queue")
}

model LinePricing {
    id  Int  @id @default(autoincrement())
    qty Int?

    costPrice      Float?
    salesPrice     Float?
    unitCostPrice  Float?
    unitSalesPrice Float?

    component   LineItemComponents? @relation(fields: [componentId], references: [id])
    componentId Int?                @unique

    lineItem   LineItem? @relation(fields: [lineItemId], references: [id])
    lineItemId Int?      @unique

    inventoryVariant   InventoryVariant? @relation(fields: [inventoryVariantId], references: [id])
    inventoryVariantId Int?
    inventory          Inventory?        @relation(fields: [inventoryId], references: [id])
    inventoryId        Int?

    @@index([inventoryId])
    @@index([inventoryVariantId])
}

model LineItemComponents {
    id Int @id @default(autoincrement())

    required Boolean @default(false)

    parent              LineItem           @relation(fields: [lineItemId], references: [id])
    lineItemId          Int
    inventoryCategory   InventoryCategory? @relation(fields: [inventoryCategoryId], references: [id])
    inventoryCategoryId Int?
    subComponent        SubComponents      @relation(fields: [subComponentId], references: [id])
    subComponentId      Int
    inventory           Inventory?         @relation(fields: [inventoryId], references: [id])
    inventoryId         Int?
    inventoryVariant    InventoryVariant?  @relation(fields: [inventoryVariantId], references: [id])
    inventoryVariantId  Int?
    price               LinePricing?
    qty                 Int?
    qtyAllocated        Float              @default(0)
    qtyInbound          Float              @default(0)
    qtyReceived         Float              @default(0)
    status              LineItemComponentStatus @default(pending)
    stockAllocations    StockAllocation[]
    inboundDemands      InboundDemand[]

    @@index([lineItemId])
    @@index([inventoryVariantId])
    @@index([inventoryId])
    @@index([subComponentId])
    @@index([inventoryCategoryId])
    @@index([status, lineItemId, inventoryVariantId], name: "idx_line_component_fulfillment")
}

model StockAllocation {
    id Int @id @default(autoincrement())

    lineItemComponentId Int
    lineItemComponent   LineItemComponents @relation(fields: [lineItemComponentId], references: [id])

    inventoryStockId Int?
    inventoryStock   InventoryStock? @relation(fields: [inventoryStockId], references: [id])

    inventoryVariantId Int
    inventoryVariant   InventoryVariant @relation(fields: [inventoryVariantId], references: [id])

	orderDeliveryId Int?
	orderDelivery   OrderDelivery? @relation(fields: [orderDeliveryId], references: [id])

    qty    Float
    status StockAllocationStatus @default(reserved)
    notes  String?

    createdAt DateTime? @default(now()) @db.Timestamp(0)
    updatedAt DateTime? @updatedAt
    deletedAt DateTime? @db.Timestamp(0)

    @@index([lineItemComponentId])
    @@index([inventoryStockId])
    @@index([inventoryVariantId])
	@@index([orderDeliveryId])
	@@index([orderDeliveryId, status, deletedAt], name: "idx_stock_allocation_dispatch")
    @@index([lineItemComponentId, status, deletedAt], name: "idx_stock_allocation_fulfillment")
}

model InboundDemand {
    id Int @id @default(autoincrement())

    lineItemComponentId Int
    lineItemComponent   LineItemComponents @relation(fields: [lineItemComponentId], references: [id])

    inventoryVariantId Int
    inventoryVariant   InventoryVariant @relation(fields: [inventoryVariantId], references: [id])

    qty         Float
    qtyReceived Float @default(0)

    inboundShipmentItemId Int?
    inboundShipmentItem   InboundShipmentItem? @relation(fields: [inboundShipmentItemId], references: [id])

    status InboundDemandStatus @default(pending)
    notes  String?

    createdAt DateTime? @default(now()) @db.Timestamp(0)
    updatedAt DateTime? @updatedAt
    deletedAt DateTime? @db.Timestamp(0)

    @@index([lineItemComponentId])
    @@index([inventoryVariantId])
    @@index([inboundShipmentItemId])
    @@index([lineItemComponentId, status, deletedAt], name: "idx_inbound_demand_fulfillment")
}

