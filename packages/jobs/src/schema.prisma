// ---- sales.adjustment.prisma ----
enum SalesOrderAdjustmentDirection {
    INCREASE
    REDUCTION
    MIXED
}

enum SalesOrderAdjustmentStatus {
    DRAFT
    PENDING_CUSTOMER
    APPROVED
    APPLYING
    APPLIED
    APPLIED_WITH_REVIEW
    REJECTED
    EXPIRED
    CANCELLED
    STALE
    FAILED
}

enum SalesOrderAdjustmentApprovalStatus {
    PENDING
    APPROVED
    REJECTED
    EXPIRED
    REVOKED
}

model SalesOrderAdjustment {
    id                    String                         @id @default(cuid())
    salesOrderId          Int
    direction             SalesOrderAdjustmentDirection
    status                SalesOrderAdjustmentStatus   @default(DRAFT)
    sourceVersion         String?                       @db.VarChar(191)
    sourceHash            String                        @db.VarChar(191)
    idempotencyKey        String                        @unique @db.VarChar(191)
    reason                String?                       @db.Text
    beforeSnapshot        Json                          @db.Json
    proposedSnapshot      Json                          @db.Json
    commitmentSnapshot    Json                          @db.Json
    settlementSnapshot    Json?                         @db.Json
    beforeGrandTotal      Decimal                       @db.Decimal(12, 2)
    proposedGrandTotal    Decimal                       @db.Decimal(12, 2)
    paymentTotal          Decimal                       @db.Decimal(12, 2)
    amountDueAfter        Decimal                       @db.Decimal(12, 2)
    walletCreditAmount    Decimal                       @default(0) @db.Decimal(12, 2)
    requestedById         Int
    submittedById         Int?
    appliedById           Int?
    walletTransactionId   Int?
    refundSalesPaymentId  Int?
    paymentLedgerEntryId  String?                       @db.VarChar(191)
    failureCode           String?                       @db.VarChar(100)
    failureMessage        String?                       @db.Text
    submittedAt           DateTime?                     @db.Timestamp(0)
    approvedAt            DateTime?                     @db.Timestamp(0)
    appliedAt             DateTime?                     @db.Timestamp(0)
    cancelledAt           DateTime?                     @db.Timestamp(0)
    failedAt              DateTime?                     @db.Timestamp(0)
    createdAt             DateTime                       @default(now()) @db.Timestamp(0)
    updatedAt             DateTime                       @updatedAt
    order                 SalesOrders                    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
    lines                 SalesOrderAdjustmentLine[]
    approvals             SalesOrderAdjustmentApproval[]

    @@index([salesOrderId, status, createdAt])
    @@index([status, submittedAt])
    @@index([requestedById, createdAt])
    @@index([walletTransactionId])
    @@index([refundSalesPaymentId])
}

model SalesOrderAdjustmentLine {
    id                 String               @id @default(cuid())
    adjustmentId       String
    lineUid            String               @db.VarChar(191)
    salesOrderItemId   Int?
    title              String               @db.VarChar(300)
    beforeQty          Decimal              @db.Decimal(12, 3)
    proposedQty        Decimal              @db.Decimal(12, 3)
    quantityDelta      Decimal              @db.Decimal(12, 3)
    beforeLineTotal    Decimal              @db.Decimal(12, 2)
    proposedLineTotal  Decimal              @db.Decimal(12, 2)
    lineTotalDelta     Decimal              @db.Decimal(12, 2)
    commitmentSnapshot Json?                @db.Json
    createdAt          DateTime             @default(now()) @db.Timestamp(0)
    updatedAt          DateTime             @updatedAt
    adjustment         SalesOrderAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

    @@unique([adjustmentId, lineUid])
    @@index([salesOrderItemId])
}

model SalesOrderAdjustmentApproval {
    id             String                             @id @default(cuid())
    adjustmentId   String
    status         SalesOrderAdjustmentApprovalStatus @default(PENDING)
    tokenHash      String                             @unique @db.VarChar(191)
    channel        String?                            @db.VarChar(50)
    recipient      String?                            @db.VarChar(255)
    responseNote   String?                            @db.Text
    evidence       Json?                              @db.Json
    expiresAt      DateTime                           @db.Timestamp(0)
    respondedAt    DateTime?                          @db.Timestamp(0)
    createdAt      DateTime                           @default(now()) @db.Timestamp(0)
    updatedAt      DateTime                           @updatedAt
    adjustment     SalesOrderAdjustment               @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

    @@index([adjustmentId, status])
    @@index([status, expiresAt])
}

