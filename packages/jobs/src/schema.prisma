    @@unique([inventoryCategoryId, valuesInventoryCategoryId])
    @@index([inventoryCategoryId])
    @@index([valuesInventoryCategoryId])
}

model InventoryVariantPricing {
    id        Int    @id @default(autoincrement())
    price     Float?
