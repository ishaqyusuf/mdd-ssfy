// ---- sales-request-telemetry.prisma ----
/// Metadata-only pilot run telemetry. A retained successful run may reference the
/// native Sales row it created solely for atomic idempotency; anonymization clears
/// that binding. Never add source text, images, contacts, provider bodies/errors,
/// credentials, or generated seed payloads to this model.
model SalesRequestGenerationRun {
    generationId                    String    @id @db.VarChar(36)
    actorUserId                     Int?
    scope                           String    @db.VarChar(191)
    configurationRevision           String    @db.VarChar(128)
    // Zero is the legacy sentinel. New pilot runs persist the exact revisions
    // captured before provider work; zero cannot authorize rollout advancement.
    pilotSettingsRevision             Int       @default(0)
    providerBenchmarkApprovalRevision Int      @default(0)
    provider                        String    @db.VarChar(32)
    model                           String    @db.VarChar(100)
    promptVersion                   String?   @db.VarChar(64)
    schemaVersion                   Int?
    requestComplexityVersion        String?   @db.VarChar(64)
    requestComplexityStratum        String?   @db.VarChar(16)
    seedDigest                     String?   @db.VarChar(67)
    consumedSalesId                Int?
