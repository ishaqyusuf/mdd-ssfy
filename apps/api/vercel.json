{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "bun ./bun-vercel/build.ts ./src/bun.ts",
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/api"
		}
	],
	"redirects": [
		{
			"source": "/",
			"destination": "/api/trpc",
			"permanent": false
		}
	],
	"regions": ["bom1"]
}
